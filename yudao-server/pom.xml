<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yudao-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        后端 Server 的主项目，通过引入需要 yudao-module-xxx 的依赖，
        从而实现提供 RESTful API 给 yudao-ui-admin、yudao-ui-user 等前端项目。
        本质上来说，它就是个空壳（容器）！
    </description>
    <url>https://github.com/YunaiV/ruoyi-vue-pro</url>

    <!-- SPK-OS: surefire 默认排除 e2e/e2e-full/e2e-cortex tag 的慢测（e2e-cortex 调真实 spk-cortex 真实 LLM，
         最慢且依赖真实服务在线，绝不默认跑），命令行 -Dsurefire.excludedGroups= 覆盖为空跑 E2E -->
    <properties>
        <surefire.excludedGroups>e2e,e2e-full,e2e-cortex</surefire.excludedGroups>
    </properties>

    <dependencies>
        <!-- SPK-OS: Spring Boot 4.1.0 quartz autoconfigure (QuartzAutoConfiguration$JdbcStoreTypeConfiguration)
             运行时引用 spring-boot-sql 的 DatabaseInitializationDependencyConfigurer，但
             spring-boot-quartz-4.1.0.pom 未声明该依赖（Boot4 拆模块 packaging 缺口）→ runtime classpath
             缺失致启动 BeanDefinitionStoreException(FileNotFoundException)。显式补 runtime 依赖修复。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-sql</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 会员中心。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-member</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 数据报表。SPK-OS: 暂未启用——jimureport-spring-boot3-starter（2.3.4/2.5.0 均基于 Spring Boot 3.x）
             的 JimuAiAssistantServiceImpl <clinit> 调用 HttpComponentsClientHttpRequestFactory.setConnectTimeout(int)，
             该方法在 Spring Framework 7 / Spring Boot 4 已移除 → 启动期 NoSuchMethodError 致整个应用启动失败。
             jimureport 目前无 Boot 4 兼容版本，待上游发布后再取消注释重启。
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-report</artifactId>
            <version>${revision}</version>
        </dependency>
        -->

        <!-- 工作流。默认注释，保证编译速度 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-bpm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 支付服务。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-pay</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 微信公众号模块。SPK-OS: 启用——mp_account 等 8 张表已由 v7.0.2 补齐
             （sql/postgresql/optional/04_mp_tables.sql），wx-java-mp-spring-boot-starter
             4.8.4-20260623 随模块传递引入（yudao-dependencies 锁定）。 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-mp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 商城相关模块。SPK-OS: 启用（product/promotion/trade/statistics） -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-product</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-promotion</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-trade</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-statistics</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- CRM 相关模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-crm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ERP 相关模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-erp</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- AI 大模型相关模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-ai</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- SPK-OS: IPD 交付子系统自研模块（依赖 bpm + ai + system） -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-spk-delivery</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- IoT 物联网相关模块。SPK-OS: 启用（依赖 iot-biz，自动引入 iot-core） -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-iot-biz</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- MES 制造执行系统相关模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-mes</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- WMS 仓库管理模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-wms</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- IM 相关模块。SPK-OS: 启用 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-im</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-protection</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动：mybatis starter 中为 optional 不传递，yudao-server 显式引入（SPK-OS 用 postgres） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- SPK-OS: IPD 端到端集成测试基座。
             yudao-spring-boot-starter-test 传递 spring-boot-starter-test（含 JUnit5/AssertJ/Mockito/
             TestRestTemplate/Awaitility）。test scope 不传递，yudao-server 须显式声明。 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <!-- SPK-OS: Spring Boot Test（含 TestRestTemplate/Awaitility），yudao-spring-boot-starter-test 已传递，
             此处显式声明以兜底 test scope 不传递场景。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SPK-OS: spring-boot-jdbc（含 DataSourceProperties）运行时必需。
             Boot 4 拆模块后 DataSourceProperties 从 spring-boot-autoconfigure 主 jar 移至
             spring-boot-jdbc 子 jar；mybatis-plus 传递路径在 Boot4 不稳定（曾因本 pom 显式
             test scope 声明被 maven 最近者优先降级为 test，致运行时 classpath 缺该类 →
             启动 ClassNotFoundException）。显式 compile scope 同时覆盖运行时与测试
             （测试 JDBC 直查 spk_task_contract/spk_artifact 行亦用此依赖）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 jar 打入其中 -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SPK-OS: Surefire 配置——E2E 测试连真库 + 起 full Spring context，单次数十秒，
                 默认排除避免拖慢常规 mvn test/build。
                 用 ${surefire.excludedGroups} 占位：surefire 3.5.3 命令行 -DexcludedGroups=
                 不覆盖 <configuration> 显式值，故须占位 + properties 默认值，命令行才能覆盖为空跑 E2E。
                 手动跑指定环节（覆盖为空→不排除 e2e tag）：
                   mvn test -pl yudao-server -Dtest=SpkIpdSmokeE2eTest -Dsurefire.excludedGroups=
                 跑全流程慢测：
                   mvn test -pl yudao-server -Dtest=SpkIpdFullFlowE2eTest -Dsurefire.excludedGroups= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
