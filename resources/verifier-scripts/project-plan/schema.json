{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectPlan",
  "description": "IPD 完整发布计划阶段 ACT-FULL-PLAN-1 项目计划书产物结构（SpkVerifierService Layer 1）。对齐 def prompt：WBS/里程碑(CDCP/PDCP/ADCP/GA/LDCP)/资源矩阵/关键路径/风险登记。",
  "type": "object",
  "required": ["plan_id", "version", "created_at", "created_by", "wbs", "milestones", "resource_matrix", "critical_path", "risk_register"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "signed_by": {
      "type": "object",
      "properties": {
        "user_id": {"type": "string"},
        "signed_at": {"type": "string"},
        "decision": {"type": "string", "enum": ["admitted", "rejected", "revision"]}
      }
    },
    "wbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["wbs_id", "name", "deliverable", "owner"],
        "properties": {
          "wbs_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "deliverable": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "duration_days": {"type": "integer", "minimum": 0}
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["milestone_id", "name", "target_date"],
        "properties": {
          "milestone_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "enum": ["CDCP", "PDCP", "ADCP", "GA", "LDCP", "CDCP/PDCP/ADCP/GA/LDCP"]},
          "target_date": {"type": "string", "minLength": 1}
        }
      }
    },
    "resource_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0},
          "allocation": {"type": "string"}
        }
      }
    },
    "critical_path": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risk_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "description", "severity"],
        "properties": {
          "risk_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["P0", "P1", "P2"]},
          "mitigation": {"type": "string"}
        }
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "total_wbs": {"type": "integer", "minimum": 0},
        "milestone_count": {"type": "integer"}
      }
    }
  }
}
