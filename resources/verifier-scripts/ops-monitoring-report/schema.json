{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpsMonitoringReport",
  "description": "IPD 完整发布生命周期阶段 ACT-FULL-LIFE-1 运营监控报告产物结构（SpkVerifierService Layer 1）。对齐 def prompt：运营数据(活跃/故障/NPS)/监控基线/改进项/移交运维。",
  "type": "object",
  "required": ["report_id", "version", "created_at", "created_by", "ops_metrics", "monitoring_baseline", "improvements"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "signed_by": {
      "type": "object",
      "properties": {
        "user_id": {"type": "string"},
        "signed_at": {"type": "string"},
        "decision": {"type": "string", "enum": ["admitted", "rejected", "revision"]}
      }
    },
    "ops_metrics": {
      "type": "object",
      "required": ["active_users", "incident_count", "nps"],
      "properties": {
        "active_users": {"type": "integer", "minimum": 0},
        "incident_count": {"type": "integer", "minimum": 0},
        "nps": {"type": "integer", "minimum": -100, "maximum": 100}
      }
    },
    "monitoring_baseline": {
      "type": "object",
      "required": ["baseline_date"],
      "properties": {
        "baseline_date": {"type": "string", "minLength": 1},
        "metrics_tracked": {"type": "string"}
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["improvement_id", "description", "priority"],
        "properties": {
          "improvement_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2"]}
        }
      }
    },
    "handover": {
      "type": "object",
      "required": ["receiver"],
      "properties": {
        "receiver": {"type": "string", "minLength": 1},
        "handover_at": {"type": "string"}
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "improvement_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
