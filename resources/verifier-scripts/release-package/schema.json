{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleasePackage",
  "description": "IPD 完整发布发布阶段 ACT-FULL-LAUNCH-1 发布包产物结构（SpkVerifierService Layer 1）。对齐 def prompt：发布包构建/部署上线/上线监控就绪。",
  "type": "object",
  "required": ["package_id", "version", "created_at", "created_by", "build", "deployment", "monitoring_readiness"],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "signed_by": {
      "type": "object",
      "properties": {
        "user_id": {"type": "string"},
        "signed_at": {"type": "string"},
        "decision": {"type": "string", "enum": ["admitted", "rejected", "revision"]}
      }
    },
    "build": {
      "type": "object",
      "required": ["artifact_url", "build_id"],
      "properties": {
        "artifact_url": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "checksum": {"type": "string"},
        "build_tool": {"type": "string"}
      }
    },
    "deployment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_env", "status"],
        "properties": {
          "target_env": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["success", "failed", "pending"]},
          "deployed_at": {"type": "string"}
        }
      }
    },
    "monitoring_readiness": {
      "type": "object",
      "required": ["alerts"],
      "properties": {
        "dashboards": {"type": "string"},
        "alerts": {"type": "string", "minLength": 1},
        "on_call": {"type": "string"}
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "env_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
