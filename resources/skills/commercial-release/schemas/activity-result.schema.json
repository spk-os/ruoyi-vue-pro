{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spk://commercial-release/activity-result.schema.json",
  "title": "SPK IPD Activity Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activityId", "stage", "status", "producer", "skill", "execution", "artifacts", "evidence", "claims", "traceability", "verifier", "humanApproval"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "activityId": {"pattern": "^ACT-03-0[2-7]-[0-9]{2}$"},
    "stage": {"enum": ["concept", "plan", "develop", "verify", "launch", "lifecycle"]},
    "status": {"enum": ["COMPLETE", "FAILED", "BLOCKED"]},
    "producer": {"$ref": "#/$defs/actor"},
    "skill": {
      "type": "object", "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "execution": {
      "type": "object", "required": ["runId", "startedAt", "finishedAt", "model", "tools"],
      "properties": {
        "runId": {"type": "string", "minLength": 1}, "startedAt": {"type": "string"},
        "finishedAt": {"type": "string"}, "model": {"type": "string", "minLength": 1},
        "tools": {"type": "array", "items": {"type": "object", "required": ["name", "version", "exitCode"]}}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRecord"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRecord"}},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claimId", "text", "evidenceIds"]}},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sourceId", "targetId", "relation"]}},
    "verifier": {"type": "object", "required": ["required", "actorId", "verdict", "receiptPath"]},
    "humanApproval": {"type": "object", "required": ["required", "status", "recordPath"]}
  },
  "$defs": {
    "actor": {"type": "object", "required": ["actorId", "role"], "properties": {"actorId": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}},
    "fileRecord": {
      "type": "object", "required": ["artifactId", "type", "path", "sha256"],
      "properties": {"artifactId": {"type": "string"}, "type": {"type": "string"}, "path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
    },
    "evidenceRecord": {
      "type": "object", "required": ["evidenceId", "type", "path", "sha256"],
      "properties": {"evidenceId": {"type": "string"}, "type": {"type": "string"}, "path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
