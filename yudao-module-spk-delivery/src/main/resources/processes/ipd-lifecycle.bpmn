<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="http://spk-os/ipd">
  <process id="ipd-lifecycle" name="IPD 生命周期阶段" isExecutable="true">
    <startEvent id="start_life"/>
    <sequenceFlow id="sf_lf_s1" sourceRef="start_life" targetRef="n_life_1"/>
    <serviceTask id="n_life_1" name="运营反馈" flowable:delegateExpression="${bpmAgentTaskDelegate}">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityId','ACT-03-07-01')}"/>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityVersion','1.0.0')}"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf_lf_1w" sourceRef="n_life_1" targetRef="n_life_1_wait"/>
    <receiveTask id="n_life_1_wait" name="等待 Agent 完成"/>
    <sequenceFlow id="sf_lf_we" sourceRef="n_life_1_wait" targetRef="end_life"/>
    <endEvent id="end_life"/>
  </process>
</definitions>
