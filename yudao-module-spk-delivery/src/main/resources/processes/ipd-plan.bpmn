<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:flowable="http://flowable.org/bpmn"
  targetNamespace="http://spk-os/ipd">
  <process id="ipd-plan" name="IPD 计划阶段" isExecutable="true">
    <startEvent id="start_plan"/>
    <sequenceFlow id="sf_p_s1" sourceRef="start_plan" targetRef="n_plan_1"/>
    <serviceTask id="n_plan_1" name="项目计划" flowable:delegateExpression="${bpmAgentTaskDelegate}">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityId','ACT-03-03-01')}"/>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityVersion','1.0.0')}"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf_p_1w" sourceRef="n_plan_1" targetRef="n_plan_1_wait"/>
    <receiveTask id="n_plan_1_wait" name="等待 Agent 完成"/>
    <sequenceFlow id="sf_p_w2" sourceRef="n_plan_1_wait" targetRef="n_plan_2"/>
    <serviceTask id="n_plan_2" name="架构设计" flowable:delegateExpression="${bpmAgentTaskDelegate}">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityId','ACT-03-03-02')}"/>
        <flowable:executionListener event="start" expression="${execution.setVariable('activityVersion','1.0.0')}"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="sf_p_2w" sourceRef="n_plan_2" targetRef="n_plan_2_wait"/>
    <receiveTask id="n_plan_2_wait" name="等待 Agent 完成"/>
    <sequenceFlow id="sf_p_we" sourceRef="n_plan_2_wait" targetRef="end_plan"/>
    <endEvent id="end_plan"/>
  </process>
</definitions>
